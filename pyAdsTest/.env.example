# Copy this file to `.env` and edit values.
#
# IMPORTANT: Values here are examples. Do not commit your real `.env`.

PLC_USERNAME=Administrator
PLC_PASSWORD=1
SENDER_AMS=192.168.0.92.1.1
ROUTE_NAME=ADS-MQTT_EN0

# MQTT broker
MQTT_ENABLED=true
MQTT_HOST=192.168.0.40
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=pyAdsTest

# PLC config file (YAML). Relative paths are resolved from the .env location.
PLC_CONFIG_FILE=plc_config.yaml
